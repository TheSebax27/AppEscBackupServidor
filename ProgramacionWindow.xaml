<Window x:Class="BackupSyncApp.ProgramacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Sync - Backups automáticos" Height="640" Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- ===================== PALETA (misma familia de toda la app) ===================== -->
        <Color x:Key="BgTop">#0F1120</Color>
        <Color x:Key="BgBottom">#1B1E33</Color>
        <Color x:Key="Accent1">#7C4DFF</Color>
        <Color x:Key="Accent2">#00E5C7</Color>

        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
            <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource Accent1}" Offset="0"/>
            <GradientStop Color="{StaticResource Accent2}" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GlassBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8FBF"/>
        <SolidColorBrush x:Key="ConsoleBg" Color="#0B0D19"/>
        <SolidColorBrush x:Key="OffColor" Color="#6B7099"/>

        <!-- ===================== BOTONES DE VENTANA ===================== -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#B9BCD4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FF5F72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON "PILL" (secundario) ===================== -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource GlassBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="15" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON ACENTO (Probar ahora) ===================== -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0F1120"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="15" Background="{TemplateBinding Background}" Opacity="0.95">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== SCROLLBAR OSCURO ===================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#3A3F63" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== LISTBOX BASE (sin resaltado default) ===================== -->
        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ===================== ITEM: tarjeta de tarea ===================== -->
        <Style x:Key="ServerItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="cardBorder" CornerRadius="14" Background="{StaticResource GlassBg}"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#7C4DFF"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#00E5C7"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#1E00E5C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ITEM: linea de log ===================== -->
        <Style x:Key="LogItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== PUNTO DE ESTADO (activada / desactivada) ===================== -->
        <Style x:Key="EstadoDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{StaticResource OffColor}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activada}" Value="True">
                    <Setter Property="Fill" Value="#00E5C7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== ETIQUETA DE ESTADO ===================== -->
        <Style x:Key="EstadoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource OffColor}"/>
            <Setter Property="Text" Value="INACTIVA"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activada}" Value="True">
                    <Setter Property="Foreground" Value="#00E5C7"/>
                    <Setter Property="Text" Value="ACTIVA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ===================== VENTANA ===================== -->
    <Border CornerRadius="24" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== barra superior custom ===== -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="BACKUPS AUTOMÁTICOS" Foreground="{StaticResource TextMuted}"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="&#xE921;" Style="{StaticResource WinBtn}" Click="BtnMinimizar_Click"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource WinBtn}" Click="BtnCerrar_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== contenido ===== -->
            <Grid Grid.Row="1" Margin="30,10,30,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Columna izquierda: tareas programadas ===== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Tareas programadas" FontWeight="Bold" FontSize="19" Foreground="White"/>
                        <Button Content="◀ Menú" Style="{StaticResource PillBtn}" Width="78"
                                HorizontalAlignment="Right" Click="BtnVolverMenu_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="+ Agregar" Style="{StaticResource PillBtn}" Width="90" Click="BtnAgregar_Click"/>
                        <Button Content="Editar" Style="{StaticResource PillBtn}" Width="70" Margin="8,0,0,0" Click="BtnEditar_Click"/>
                        <Button Content="Eliminar" Style="{StaticResource PillBtn}" Width="72" Margin="8,0,0,0" Click="BtnEliminar_Click"/>
                    </StackPanel>

                    <ListBox Grid.Row="2" x:Name="ListaTareas" Style="{StaticResource CleanListBox}"
                             ItemContainerStyle="{StaticResource ServerItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Nombre}" Foreground="White"
                                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource EstadoDot}" Margin="0,0,6,0"/>
                                            <TextBlock Style="{StaticResource EstadoLabel}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding ResumenHorario}" FontSize="12"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Probar ahora" Style="{StaticResource AccentBtn}"
                                                HorizontalAlignment="Stretch" Tag="{Binding}" Click="BtnProbarAhora_Click"/>
                                        <Button Grid.Column="2" Content="Activar/Desactivar" Style="{StaticResource PillBtn}"
                                                HorizontalAlignment="Stretch" Tag="{Binding}" Click="BtnActivarDesactivar_Click"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- separador vertical -->
                <Border Grid.Column="1" Width="1" Background="{StaticResource GlassBorder}" Margin="0,4"/>

                <!-- ===== Columna derecha: estado + consola de log ===== -->
                <Grid Grid.Column="2" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Estado del proceso" FontWeight="Bold" FontSize="20"
                               Foreground="White" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtEstadoActual"
                                   Text="Selecciona una tarea para probarla o activarla"
                                   Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource ConsoleBg}" BorderBrush="{StaticResource GlassBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="14">
                        <ListBox x:Name="ListaLog" Style="{StaticResource CleanListBox}"
                                 ItemContainerStyle="{StaticResource LogItem}"
                                 FontFamily="Consolas" FontSize="12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Texto}" Foreground="{Binding Color}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource PillBtn}"
                                Width="100" IsEnabled="False" Click="BtnCancelar_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
