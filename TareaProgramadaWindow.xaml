<Window x:Class="BackupSyncApp.TareaProgramadaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarea programada" Height="610" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="15">

        <TextBlock Text="Nombre (ej: Backup nocturno 180)" Margin="0,0,0,3"/>
        <TextBox x:Name="TxtNombre" Margin="0,0,0,10"/>

        <TextBlock Text="Tipo de backup" Margin="0,0,0,3"/>
        <ComboBox x:Name="CmbTipo" Margin="0,0,0,10" SelectionChanged="CmbTipo_SelectionChanged">
            <ComboBoxItem Content="Backup SQL (Windows: 180/181/182)"/>
            <ComboBoxItem Content="Contabo - Base de datos"/>
            <ComboBoxItem Content="Contabo - Archivos"/>
        </ComboBox>

        <TextBlock Text="Servidor a respaldar" Margin="0,0,0,3"/>
        <ComboBox x:Name="CmbConexionBackup" DisplayMemberPath="Nombre" Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkEncadenar" Content="Después, bajar los archivos nuevos a mi disco automáticamente"
                  Checked="ChkEncadenar_Changed" Unchecked="ChkEncadenar_Changed" Margin="0,0,0,10"/>

        <TextBlock x:Name="LblConexionArchivos" Text="Conexión de 'Pasar archivos' a usar" Margin="0,0,0,3"/>
        <ComboBox x:Name="CmbConexionArchivos" DisplayMemberPath="Nombre" Margin="0,0,0,10"/>

        <TextBlock Text="Hora (formato 24h)" Margin="0,0,0,3"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="CmbHora" Width="70"/>
            <TextBlock Text=":" FontSize="16" Margin="8,3,8,0"/>
            <ComboBox x:Name="CmbMinuto" Width="70"/>
        </StackPanel>

        <TextBlock Text="Días de la semana" Margin="0,0,0,5"/>
        <WrapPanel Margin="0,0,0,10">
            <CheckBox x:Name="ChkLun" Content="Lun" Margin="0,0,10,5"/>
            <CheckBox x:Name="ChkMar" Content="Mar" Margin="0,0,10,5"/>
            <CheckBox x:Name="ChkMie" Content="Mié" Margin="0,0,10,5"/>
            <CheckBox x:Name="ChkJue" Content="Jue" Margin="0,0,10,5"/>
            <CheckBox x:Name="ChkVie" Content="Vie" Margin="0,0,10,5"/>
            <CheckBox x:Name="ChkSab" Content="Sáb" Margin="0,0,10,5"/>
            <CheckBox x:Name="ChkDom" Content="Dom" Margin="0,0,10,5"/>
        </WrapPanel>

        <CheckBox x:Name="ChkActivada" Content="Activar esta tarea (se registra en el Programador de Windows al guardar)"
                  Margin="0,5,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button Content="Guardar" Width="90" Click="BtnGuardar_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
