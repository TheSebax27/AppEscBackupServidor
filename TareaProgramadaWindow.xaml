<Window x:Class="BackupSyncApp.TareaProgramadaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarea programada" Height="700" Width="560"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ===================== PALETA (misma familia de toda la app) ===================== -->
        <Color x:Key="BgTop">#0F1120</Color>
        <Color x:Key="BgBottom">#1B1E33</Color>
        <Color x:Key="Accent1">#7C4DFF</Color>
        <Color x:Key="Accent2">#00E5C7</Color>

        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
            <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource Accent1}" Offset="0"/>
            <GradientStop Color="{StaticResource Accent2}" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GlassBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8FBF"/>
        <SolidColorBrush x:Key="FieldBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="PopupBg" Color="#1B1E33"/>

        <!-- ===================== BOTON DE VENTANA (cerrar) ===================== -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#B9BCD4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FF5F72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ETIQUETA DE CAMPO ===================== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- ===================== TEXTBOX ESTILO GLASS ===================== -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#00E5C7"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3D4270"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== COMBOBOX ESTILO GLASS ===================== -->
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ToggleButton x:Name="ToggleBtn" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalContentAlignment="Right" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource PopupBg}" BorderBrush="{StaticResource GlassBorder}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="16" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220" Margin="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3D4270"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#1E00E5C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON PILL SECUNDARIO (Cancelar) ===================== -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource GlassBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON ACENTO (Guardar) ===================== -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Foreground" Value="#0F1120"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{StaticResource AccentBrush}" Opacity="0.95">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CHECKBOX ESTILO TOGGLE (ancho completo) ===================== -->
        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border CornerRadius="12" Background="{StaticResource GlassBg}"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="box" Grid.Column="0" Width="22" Height="22" CornerRadius="7"
                                        BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                                        Background="Transparent" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0"/>
                                </Border>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="mark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CHIP DE DÍA (Lun, Mar, ...) ===================== -->
        <Style x:Key="DayChip" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="chip" Width="52" Height="40" CornerRadius="10" Background="{StaticResource GlassBg}"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0F1120"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== SEPARADOR ===================== -->
        <Style x:Key="SectionSeparator" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource GlassBorder}"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <!-- ===================== SCROLLBAR OSCURO ===================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#3A3F63" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== VENTANA ===================== -->
    <Border CornerRadius="24" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== barra superior custom ===== -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="TAREA PROGRAMADA" Foreground="{StaticResource TextMuted}"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="&#xE8BB;" Style="{StaticResource WinBtn}" Click="BtnCerrarVentana_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== contenido ===== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel Margin="30,6,30,10">

                        <TextBlock Text="Configurar tarea" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Qué respaldar, cuándo, y si encadenar con la descarga automática" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,18"/>

                        <TextBlock Text="Nombre (ej: Backup nocturno 180)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Tipo de backup" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbTipo" Style="{StaticResource FieldCombo}" Margin="0,0,0,14"
                                  SelectionChanged="CmbTipo_SelectionChanged">
                            <ComboBoxItem Content="Backup SQL (Windows: 180/181/182)"/>
                            <ComboBoxItem Content="Contabo - Base de datos"/>
                            <ComboBoxItem Content="Contabo - Archivos"/>
                        </ComboBox>

                        <TextBlock Text="Servidor a respaldar" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbConexionBackup" Style="{StaticResource FieldCombo}"
                                  DisplayMemberPath="Nombre" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkEncadenar" Content="Después, bajar los archivos nuevos a mi disco automáticamente"
                                  Style="{StaticResource ToggleCheck}" Margin="0,0,0,14"
                                  Checked="ChkEncadenar_Changed" Unchecked="ChkEncadenar_Changed"/>

                        <TextBlock x:Name="LblConexionArchivos" Text="Conexión de 'Pasar archivos' a usar" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbConexionArchivos" Style="{StaticResource FieldCombo}"
                                  DisplayMemberPath="Nombre" Margin="0,0,0,14"/>

                        <Separator Style="{StaticResource SectionSeparator}" Margin="0,6,0,16"/>

                        <TextBlock Text="Hora (formato 24h)" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ComboBox x:Name="CmbHora" Style="{StaticResource FieldCombo}" Width="90"/>
                            <TextBlock Text=":" FontSize="18" FontWeight="Bold" Foreground="White" Margin="10,6,10,0"/>
                            <ComboBox x:Name="CmbMinuto" Style="{StaticResource FieldCombo}" Width="90"/>
                        </StackPanel>

                        <TextBlock Text="Días de la semana" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox x:Name="ChkLun" Content="Lun" Style="{StaticResource DayChip}"/>
                            <CheckBox x:Name="ChkMar" Content="Mar" Style="{StaticResource DayChip}"/>
                            <CheckBox x:Name="ChkMie" Content="Mié" Style="{StaticResource DayChip}"/>
                            <CheckBox x:Name="ChkJue" Content="Jue" Style="{StaticResource DayChip}"/>
                            <CheckBox x:Name="ChkVie" Content="Vie" Style="{StaticResource DayChip}"/>
                            <CheckBox x:Name="ChkSab" Content="Sáb" Style="{StaticResource DayChip}"/>
                            <CheckBox x:Name="ChkDom" Content="Dom" Style="{StaticResource DayChip}"/>
                        </WrapPanel>

                        <Separator Style="{StaticResource SectionSeparator}" Margin="0,12,0,16"/>

                        <CheckBox x:Name="ChkActivada"
                                  Content="Activar esta tarea (se registra en el Programador de Windows al guardar)"
                                  Style="{StaticResource ToggleCheck}"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===== pie con acciones ===== -->
                <Border Grid.Row="1" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0" Padding="30,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource PillBtn}" Width="100" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                        <Button Content="Guardar" Style="{StaticResource AccentBtn}" Width="110" Click="BtnGuardar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
