<Window x:Class="BackupSyncApp.ConexionBackupContaboWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexión de backup Contabo" Height="700" Width="560"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ===================== PALETA (misma familia de toda la app) ===================== -->
        <Color x:Key="BgTop">#0F1120</Color>
        <Color x:Key="BgBottom">#1B1E33</Color>
        <Color x:Key="Accent1">#7C4DFF</Color>
        <Color x:Key="Accent2">#00E5C7</Color>

        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
            <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource Accent1}" Offset="0"/>
            <GradientStop Color="{StaticResource Accent2}" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GlassBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8FBF"/>
        <SolidColorBrush x:Key="FieldBg" Color="#14FFFFFF"/>

        <!-- ===================== BOTON DE VENTANA (cerrar) ===================== -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#B9BCD4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FF5F72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ETIQUETA DE CAMPO ===================== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- ===================== NOTA / TEXTO DE AYUDA ===================== -->
        <Style x:Key="HelpNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
        </Style>

        <!-- ===================== TEXTBOX ESTILO GLASS (una línea) ===================== -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#00E5C7"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3D4270"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TEXTBOX ESTILO GLASS (multilínea, para listas) ===================== -->
        <Style x:Key="FieldBoxMulti" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3D4270"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON PILL SECUNDARIO (..., Cancelar) ===================== -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource GlassBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON ACENTO (Guardar) ===================== -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Foreground" Value="#0F1120"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{StaticResource AccentBrush}" Opacity="0.95">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON MINI "..." (buscar llave) ===================== -->
        <Style x:Key="MiniBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ===================== SEPARADOR CON TÍTULO DE SECCIÓN ===================== -->
        <Style x:Key="SectionSeparator" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource GlassBorder}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>

        <!-- ===================== SCROLLBAR OSCURO ===================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#3A3F63" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== VENTANA ===================== -->
    <Border CornerRadius="24" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== barra superior custom ===== -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="CONEXIÓN DE BACKUP CONTABO" Foreground="{StaticResource TextMuted}"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="&#xE8BB;" Style="{StaticResource WinBtn}" Click="BtnCerrarVentana_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== contenido ===== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel Margin="30,6,30,10">

                        <TextBlock Text="Datos de conexión" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Cómo nos conectamos al servidor Contabo por SSH" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,18"/>

                        <TextBlock Text="Nombre (ej: Contabo 1)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Servidor - IP" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtServidor" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Usuario SSH" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtUsuario" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ruta llave privada SSH (nuestra)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtLlave" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="..." Style="{StaticResource MiniBtn}"
                                    VerticalAlignment="Bottom" Click="BtnBuscarLlave_Click"/>
                        </Grid>

                        <Separator Style="{StaticResource SectionSeparator}" Margin="0,20,0,16"/>

                        <TextBlock Text="Backup de base de datos" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Opcional: dejá vacío si este servidor no hace backup de BD" Style="{StaticResource HelpNote}"/>

                        <TextBlock Text="Nombre de la base de datos" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNombreBd" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Tablas a respaldar (una por línea)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtTablas" Style="{StaticResource FieldBoxMulti}" Margin="0,0,0,14"/>

                        <TextBlock Text="Carpeta backup local en el Contabo (ej: /var/backups/backup_db_documents)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCarpetaBackupDb" Style="{StaticResource FieldBox}" Margin="0,0,0,4"/>

                        <Separator Style="{StaticResource SectionSeparator}" Margin="0,20,0,16"/>

                        <TextBlock Text="Backup de archivos" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="La PRIMERA carpeta de la lista se conserva; el resto se vacía tras el envío."
                                   Style="{StaticResource HelpNote}"/>

                        <TextBlock Text="Carpetas de origen (una por línea, el orden importa)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCarpetasOrigen" Style="{StaticResource FieldBoxMulti}" Margin="0,0,0,4"/>

                        <Separator Style="{StaticResource SectionSeparator}" Margin="0,20,0,16"/>

                        <TextBlock Text="Envío al servidor central" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Compartido para BD y archivos" Style="{StaticResource HelpNote}"/>

                        <TextBlock Text="Usuario SSH del central" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCentralUsuario" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="IP del servidor central" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCentralIp" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Ruta destino en el central (BD)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCentralDestinoDb" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Ruta destino en el central (Archivos)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCentralDestinoArchivos" Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Ruta llave SSH (la que ya está guardada en el Contabo)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtLlaveEnContabo" Style="{StaticResource FieldBox}" Margin="0,0,0,4"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===== pie con acciones ===== -->
                <Border Grid.Row="1" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0" Padding="30,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource PillBtn}" Width="100" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                        <Button Content="Guardar" Style="{StaticResource AccentBtn}" Width="110" Click="BtnGuardar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
