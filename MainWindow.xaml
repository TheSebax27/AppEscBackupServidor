<Window x:Class="BackupSyncApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Sync" Height="450" Width="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Agregar conexión" Width="150" Height="30" Click="BtnAgregar_Click"/>
            <Button Content="Editar" Width="90" Height="30" Margin="10,0,0,0" Click="BtnEditar_Click"/>
            <Button Content="Eliminar" Width="90" Height="30" Margin="10,0,0,0" Click="BtnEliminar_Click"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="ListaConexiones" DisplayMemberPath="Nombre"/>
    </Grid>
</Window>