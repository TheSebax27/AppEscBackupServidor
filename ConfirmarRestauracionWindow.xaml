<Window x:Class="BackupSyncApp.ConfirmarRestauracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar restauración" Height="640" Width="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- ===================== PALETA (misma familia de toda la app) ===================== -->
        <Color x:Key="BgTop">#0F1120</Color>
        <Color x:Key="BgBottom">#1B1E33</Color>
        <Color x:Key="Accent1">#7C4DFF</Color>
        <Color x:Key="Accent2">#00E5C7</Color>
        <Color x:Key="Danger1">#FF5F72</Color>
        <Color x:Key="Danger2">#FF9A5A</Color>

        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
            <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource Accent1}" Offset="0"/>
            <GradientStop Color="{StaticResource Accent2}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource Danger1}" Offset="0"/>
            <GradientStop Color="{StaticResource Danger2}" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GlassBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8FBF"/>
        <SolidColorBrush x:Key="FieldBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="DangerBg" Color="#1EFF5F72"/>
        <SolidColorBrush x:Key="DangerBorder" Color="#3DFF5F72"/>

        <!-- ===================== BOTON DE VENTANA (cerrar) ===================== -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#B9BCD4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FF5F72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ETIQUETA DE CAMPO ===================== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- ===================== TEXTBOX ESTILO GLASS ===================== -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#00E5C7"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3D4270"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF5F72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON PILL SECUNDARIO (Cancelar) ===================== -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource GlassBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTON DE PELIGRO (Confirmar restauración) ===================== -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{StaticResource DangerBrush}" Opacity="0.95">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="b" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#6B7099"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ITEM: tarjeta de ZIP ===================== -->
        <Style x:Key="ZipItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="cardBorder" CornerRadius="12" Background="{StaticResource GlassBg}"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon" Grid.Column="0" Text="&#xF12B;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="White" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3D4270"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource DangerBorder}"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource DangerBg}"/>
                                <Setter TargetName="icon" Property="Foreground" Value="#FF5F72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ===================== SCROLLBAR OSCURO ===================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#3A3F63" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== VENTANA ===================== -->
    <Border CornerRadius="24" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== barra superior custom ===== -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="CONFIRMAR RESTAURACIÓN" Foreground="{StaticResource TextMuted}"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="&#xE8BB;" Style="{StaticResource WinBtn}" Click="BtnCerrarVentana_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== contenido ===== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="30,6,30,10">

                    <!-- ===== banner de advertencia ===== -->
                    <Border Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,4,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                    Background="{StaticResource DangerBrush}" Margin="0,0,14,0">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Esta acción sobreescribe las bases de datos existentes"
                                           FontWeight="Bold" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="No se puede deshacer. Verifica que elegiste el servidor y el ZIP correctos."
                                           FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Selecciona el ZIP a restaurar" FontSize="14" FontWeight="Bold"
                               Foreground="White" Margin="2,0,0,10"/>

                    <Border Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="10" Height="220" Margin="0,0,0,20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="ListaZips" Style="{StaticResource CleanListBox}"
                                     ItemContainerStyle="{StaticResource ZipItem}"
                                     SelectionChanged="ListaZips_SelectionChanged"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="Escribe RESTAURAR para habilitar el botón:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtConfirmacion" Style="{StaticResource FieldBox}"
                             TextChanged="TxtConfirmacion_TextChanged"/>

                </StackPanel>

                <!-- ===== pie con acciones ===== -->
                <Border Grid.Row="1" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0" Padding="30,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource PillBtn}" Width="100" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                        <Button x:Name="BtnConfirmar" Content="Confirmar restauración" Style="{StaticResource DangerBtn}"
                                Width="200" IsEnabled="False" Click="BtnConfirmar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
