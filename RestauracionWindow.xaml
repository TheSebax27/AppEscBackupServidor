<Window x:Class="BackupSyncApp.RestauracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Sync - Restaurar backups" Height="550" Width="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Servidores" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <Button Grid.Row="0" Content="◀ Menú" Width="70" Height="24"
                    HorizontalAlignment="Right" Click="BtnVolverMenu_Click"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="+ Agregar" Width="85" Click="BtnAgregar_Click"/>
                <Button Content="Editar" Width="70" Margin="5,0,0,0" Click="BtnEditar_Click"/>
                <Button Content="Eliminar" Width="70" Margin="5,0,0,0" Click="BtnEliminar_Click"/>
            </StackPanel>

            <ListBox Grid.Row="2" x:Name="ListaConexiones">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Nombre}"
                                       VerticalAlignment="Center" FontSize="13"/>
                            <Button Grid.Column="1" Content="Restaurar" Width="90"
                                    Tag="{Binding}" Click="BtnRestaurar_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TxtEstadoActual"
                       Text="Selecciona un servidor y dale clic a Restaurar"
                       FontWeight="Bold" Margin="0,0,0,8"/>

            <ListBox Grid.Row="1" x:Name="ListaLog" FontFamily="Consolas" FontSize="12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{Binding Color}"/>
                        <Setter Property="Padding" Value="2,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Texto}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnCancelar" Content="Cancelar" Width="90"
                        IsEnabled="False" Click="BtnCancelar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
